flowchart TD
    A["输入起始网址、视频上限 N、下载目录"] --> B["校验参数并创建扫描会话"]
    B --> C["初始化页面队列、访问集合和视频集合"]

    C --> D{"是否还能继续扫描？"}

    D -- "没有更多任务或触发保护限制" --> S["结束扫描并显示原因<br/>保留已发现视频列表"]

    D -- "可以继续" --> E["取出页面任务<br/>检查范围、去重和访问频率"]
    E --> F["获取页面<br/>HTTP 优先，可选浏览器增强"]
    F --> G{"获取成功？"}

    G -- "否" --> H["记录错误并有限重试"]
    H --> D

    G -- "是" --> I["发现视频候选、详情链接和分页线索"]
    I --> J{"还有候选且未停止？"}

    J -- "是" --> K["解析下一个候选<br/>获取视频标识、媒体地址和格式"]
    K --> L{"有效且尚未收录？"}

    L -- "否" --> J
    L -- "是" --> M["原子检查数量余量并收录<br/>保存记录，立即更新 TUI"]
    M --> N{"已收录数量达到 N？"}

    N -- "否" --> J
    N -- "是" --> O["设置停止标志<br/>停止派发新任务<br/>取消可取消的在途任务"]
    O --> S

    J -- "没有更多候选" --> P["按范围和深度规则<br/>加入详情页、下一页及站内链接"]
    P --> D

    J -- "用户停止" --> O

    S --> T{"用户选择操作"}
    T -- "查看或导出" --> U["查看详情、复制地址<br/>导出 TXT、CSV 或 JSON"]
    T -- "下载勾选项" --> V["创建下载任务<br/>校验目标目录和下载配置"]

    V --> W["必要时重新解析媒体地址"]
    W --> X["执行下载及必要的音视频合并<br/>实时更新进度"]
    X --> Y["记录完成、失败或取消状态<br/>确认最终文件，允许重试"]